# ------------------------------------------------------------
cache/

# ------------------------------------------------------------
# Local workspace / runtime state
# ------------------------------------------------------------
workspace/
runtime_trace.log
*.log

# Temporary / backup files
*.tmp
*.temp
*.bak
*.old
*.backup
*~
~$*

# ------------------------------------------------------------
# Reverse-engineering material copied/extracted from Redemption
# Do NOT commit original game assets/binaries
# ------------------------------------------------------------
research/original/
# Locally imported third-party mod assets and their installation manifest
content_packs/

# Generated binary-analysis dumps
research/*.bytecode.txt
research/ALL_CODEX.bytecode.txt
research/Vampire.strings.txt

# ------------------------------------------------------------
# Generated backups / checkpoints
# ------------------------------------------------------------
research/build_backups/
research/runtime_test/backups/
research/checkpoints/


# ------------------------------------------------------------
# Runtime/deployment scratch data
# ------------------------------------------------------------
research/runtime_test/runtime_trace.log
research/runtime_test/*.log

