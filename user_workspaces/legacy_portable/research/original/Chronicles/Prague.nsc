location SilverMines            P1_SIM1.nil             SIM1_5_1.nsd    mapPragueOT.nui      mapBonnSilvermines         0x0
location SilverMines2           P1_SIM2.nil             SIM2_5_1.nsd    mapPragueOT.nui      mapBonnSilvermines         0x0
location SilverMines3           P1_SIM3.nil             SIM3_5_1.nsd    mapPragueOT.nui      mapBonnSilvermines         0x0
                                                                                                                        
location SilverMinesNight       P1_SIMN.nil             SIMN_7_1.nsd    mapPragueOT.nui      mapBonnSilvermines         0x0
                                                                                                                        
location Monastery              P1_MON1.nil             MON1_8_2.nsd    mapPragueOT.nui      mapPetrinHillMonastery     0x0
