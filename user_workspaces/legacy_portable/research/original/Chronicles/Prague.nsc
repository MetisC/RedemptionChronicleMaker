#
# EXIT FLAGS:
#
# CLOSED	0x1		This exit is closed
# ONEWAY	0x100		This exit is one way (this is actually a load time only flag)
#


location Convent                P1_CNVT.nil             CNVT_3_1.nsd    mapPragueOT.nui      mapConvent                 0x0020 
location ConventDay             P1_CTDY.nil             CTDY_4_1.nsd    mapPragueOT.nui      mapConvent                 0x0020
