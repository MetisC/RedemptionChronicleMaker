location Inn4Stags              P1_INN4.nil             INN4_7_1.nsd    mapPragueOT.nui      mapFourStagsInn            0x0020
location JudithBridge           P1_JUDB.nil             JUDB_7_1.nsd    mapPragueOT.nui      mapJudithBridge            0x0060
location Unorna                 P1_UNOR.nil             UNOR_7_1.nsd    mapPragueOT.nui      mapUnornas                 0x0020
location Haven                  P1_HAVN.nil             HAVN_7_7.nsd    mapPragueOT.nui      mapUniversityHaven         0x00b4
location PetrinHill             P1_HILL.nil             HILL_7_1.nsd    mapPragueOT.nui      mapPetrinHillMonastery     0x0060
