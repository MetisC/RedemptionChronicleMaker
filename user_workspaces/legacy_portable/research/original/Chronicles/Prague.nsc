location GoldenLane             P1_GOLD.nil             GOLD_7_1.nsd    mapPragueOT.nui      mapGoldenLane              0x0060

# these dummy locations are here so we can show the map markers from a script
location DummyNorthQuarter      dummy.nil               null            mapPragueOT.nui      mapNorthQuarter            0x0020
location DummyNorthGate         dummy.nil               null            mapPragueOT.nui      mapNorthGate               0x0020
location DummyNorthQuarterGate  dummy.nil               null            mapPragueNQ.nui      mapNorthQuarterGate        0x0028

#location SilverMines            P1_SIM1.nil             SIM1_5_1.nsd    mapPragueOT.nui     map00                      0x0
#location SilverMines2           P1_SIM2.nil             SIM2_5_1.nsd    mapPragueOT.nui     map00                      0x0
