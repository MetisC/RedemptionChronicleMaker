location WestLondon             l1_west.nil		      null  	mapLondonWest.nui    mapLondonWestMain    0x0040
location EastLondon             l1_east.nil           null  	mapLondonEast.nui    mapLondonEastMain    0x0040

location SocietyOfLeopold3      L1_SOC3.nil          	null     mapLondonWest.nui    mapSocietyOfLeopold  0x0
location SocietyOfLeopold2      L1_SOC2.nil          	null 	   mapLondonWest.nui    mapSocietyOfLeopold  0x0
location SocietyOfLeopold1      L1_SOC1.nil		      null  	mapLondonWest.nui    mapSocietyOfLeopold  0x0

location TowerOfLondon1         l1_tol1.nil           null  	mapLondonEast.nui    mapTowerOfLondon     0x0
location TowerOfLondon2         l1_tol2.nil           null  	mapLondonEast.nui    mapTowerOfLondon     0x0
location TowerOfLondon3         l1_tol3.nil           null  	mapLondonEast.nui    mapTowerOfLondon     0x0
location TowerOfLondon4         l1_tol4.nil           null  	mapLondonEast.nui    mapTowerOfLondon     0x0

location Bridge                 l1_havn.nil        	null  	mapLondonEast.nui    mapBridgeHaven       0x00b4
location Brothel                l1_brot.nil           null  	mapLondonEast.nui    mapSetiteBrothel     0x0000

location SetiteTemple1          L1_SET1.nil           null  	mapLondonEast.nui    mapSetiteBrothel     0x0
location SetiteTemple2          L1_SET2.nil           null  	mapLondonEast.nui    mapSetiteBrothel     0x0
location SetiteTemple3          L1_SET3.nil           null  	mapLondonEast.nui    mapSetiteBrothel     0x0
location SetiteTemple4          L1_SET4.nil           null  	mapLondonEast.nui    mapSetiteBrothel     0x0

location CurioShop              L1_CURI.nil          	null  	mapLondonWest.nui    mapCurioShop         0x0000
location ClubTenebrae           L1_TEN1.nil          	null  	mapLondonWest.nui    mapClubTenebrae      0x0000
location CargoShip      	     L1_CARG.nil       	   null     mapLondonEast.nui    mapStMagdalena       0x0000

# WestLondon exits
exit	WestLondon,0		SocietyOfLeopold1,0
exit  WestLondon,1      CurioShop,0
exit  WestLondon,2      EastLondon,0
exit	WestLondon,3		ClubTenebrae,0

# EastLondon exits
exit    EastLondon,1            TowerOfLondon1,0
exit    EastLondon,2            Bridge,0
exit    EastLondon,3            CargoShip,0
exit    EastLondon,4            Brothel,0

# TowerOfLondon exits
exit    TowerOfLondon1,1        TowerOfLondon2,0
exit    TowerOfLondon2,1        TowerOfLondon3,0
exit    TowerOfLondon3,1        TowerOfLondon4,0

# Brothel exits
exit    Brothel,1               SetiteTemple1,0

# SetiteTemple exits
exit    SetiteTemple1,1         SetiteTemple2,0
exit    SetiteTemple2,1         SetiteTemple3,0
exit    SetiteTemple3,1         SetiteTemple4,0

# SocietyOfLeopold exits

exit SocietyOfLeopold3,1        SocietyOfLeopold2,0
exit SocietyOfLeopold2,1        SocietyOfLeopold1,1
	

##########################################################
# Chronicle Settings
##########################################################

metafile    MP_London_Null.nmf
portal      Bridge 15
reviveloc   WestLondon 0
flags       0x7

##########################################################