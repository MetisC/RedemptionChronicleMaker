##############################################################
#                                                            #
# MP_LeavesThree.nsc - Chronicle script for the multiplayer  #
                       "Leaves of Three" episode.            #
#                                                            #
##############################################################
#                                                            #
# (c) 1999 Nihilistic Software, Inc. All rights reserved     #
#                                                            #
# Author: S. Thoms  11/3/99                                  #
#                                                            #
# NOTE: DO NOT CHANGE THE ORDER OF THESE LOCATIONS           #
#                                                            #
#       TWO SCRIPTS ARE ACCESSING THESE BY THEIR INDEX IN    #
#       THE CHRONICLE FILE:                                  #
#       MP_LOTChronicle                                      #
#       LOT_UTWN_Advance                                     #
#                                                            #
##############################################################


location BarclayLobby		N1_LOBY.nil		LOBY_LOT_1_1.nsd  mapNYCmidtown.nui    mapBarclaySouth         0x0020
                                                                                                         
location NewYorkDocks		n1_dock.nil		DOCK_LOT_1_1.nsd	mapNYCdocks.nui      mapNYDocksMain          0x0020
location NewYorkUptown		n1_utwn.nil		UTWN_LOT_9_1.nsd	mapNYCmidtown.nui    mapNYMidtownMain        0x0020
                                                                                                         
location Factory1		      n1_fac1.nil		FAC1_LOT_5_1.nsd	mapNYCmidtown.nui    mapOrsisFactory         0x0020
location Factory2		      n1_fac2.nil		FAC2_LOT_5_1.nsd	mapNYCmidtown.nui    mapOrsisFactory         0x0020
location Factory3		      n1_fac3.nil		FAC3_LOT_5_1.nsd	mapNYCmidtown.nui    mapOrsisFactory         0x0020
location Factory4		      n1_fac4.nil		FAC4_LOT_5_1.nsd	mapNYCmidtown.nui    mapOrsisFactory         0x0020
                                                                                                         
location Sewers1		      N1_SEW1.nil		SEW1_LOT_12_1.nsd	mapNYCdocks.nui      mapSewers               0x0
location Sewers2		      N1_SEW2.nil		SEW2_LOT_12_1.nsd	mapNYCdocks.nui      mapSewers               0x0
location Sewers3		      N1_SEW3.nil		SEW3_LOT_12_1.nsd	mapNYCdocks.nui      mapSewers               0x0
location Sewers4		      N1_SEW4.nil		SEW4_LOT_12_1.nsd	mapNYCdocks.nui      mapSewers               0x0

location Warehouse1	      N1_WAR1.nil		WAR1_LOT_11_1.nsd	mapNYCdocks.nui      mapGiovanniWarehouse    0x0
location Warehouse2	      N1_WAR2.nil		WAR2_LOT_11_1.nsd	mapNYCdocks.nui      mapGiovanniWarehouse    0x0
location Warehouse3	      N1_WAR3.nil		WAR3_LOT_11_1.nsd	mapNYCdocks.nui      mapGiovanniWarehouse    0x0

location GunHaven		      N1_GUNH.nil		GUNH_LOT_1_1.nsd	mapNYCdocks.nui      mapGunHaven             0x0020

location NewMoon		      N1_NEWM.nil		NEWM_LOT_1_1.nsd	mapNYCmidtown.nui    mapNewMoon              0x0020

location Apartment	      N1_DEVN.nil		DEVN_LOT_8_1.nsd	mapNYCdocks.nui      mapDevNulls             0x0020

location SlumRoom          N1_SLUM.nil    SLUM_LOT_7_1.nsd  mapNYCdocks.nui      mapDevNulls             0x0020

location SuiteHaven        N1_SUIT.nil    SUIT_LOT_1_1.nsd  mapNYCmidtown.nui    mapBarclaySouth         0x00b4

# NewYorkDocks exits
exit NewYorkDocks,1		GunHaven,0
exit NewYorkDocks,2		Sewers1,0
exit NewYorkDocks,3		NewYorkUptown,0
exit NewYorkDocks,4		Apartment,0
exit NewYorkDocks,5		Warehouse1,0
exit NewYorkDocks,6     SlumRoom,0

# NewYorkUptown exits
exit NewYorkUptown,2		BarclayLobby,0
exit NewYorkUptown,3		Factory4,0
exit NewYorkUptown,4		NewMoon,0

# Factory exits
exit Factory4,1		   Factory1,0
exit Factory4,2		   Factory1,1
exit Factory4,3		   Factory2,0
exit Factory4,4		   Factory2,1
exit Factory4,5		   Factory3,0
exit Factory4,6		   Factory3,1

# Sewers exits
exit Sewers1,1			Sewers2,0
exit Sewers2,1			Sewers3,0
exit Sewers3,2			Sewers4,0

# Warehouse exits
exit Warehouse1,1	        Warehouse2,0
exit Warehouse2,1	        Warehouse3,0
exit Warehouse3,1         Warehouse1,2

# BarclayLobby exits
exit BarclayLobby,2             SuiteHaven,0
exit BarclayLobby,3             Sewers4,1

script      MP_LOTChronicle
metafile    MP_LOT.nmf
portal      NewYorkDocks 5
reviveloc   BarclayLobby, 0
flags       0x3
