;swordslash     SerenaDaggerAttack.nad	noloop

;hurt			serena_damagefront.nad	noloop
	 
;deathquick	serena_Death.nad	noloop endpause 

talk	anezkaTorchIdle.nad	lowpriority

special3			anezkaTorchStand.nad

